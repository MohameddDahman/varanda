# Canonical site origin (used for metadata, sitemap and share images)
NEXT_PUBLIC_SITE_URL=https://example.com

# Written by `npx convex dev` (or scripts/convex-local.mjs): requests, projects and photos live here
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Admin dashboard (/admin). The token must also be set in Convex: npx convex env set ADMIN_TOKEN <token>
ADMIN_PASSWORD=
ADMIN_TOKEN=
